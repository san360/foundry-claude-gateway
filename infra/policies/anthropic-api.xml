<!--
  Azure API Management - AI gateway policy for the Anthropic Messages API
  backed by Claude models in Microsoft Foundry.

  Client call:   https://<apim>.azure-api.net/anthropic/v1/messages
  Backend call:  https://<foundry>.services.ai.azure.com/anthropic/v1/messages

  Behaviour is driven by named values so the same deployment can demonstrate
  several authentication topologies without redeploying the policy:

    {{client-auth-mode}}        subscriptionKey | entra | either
    {{backend-auth-mode}}       managedIdentity | passthrough
    {{entra-tenant-id}}         tenant used to validate inbound Entra tokens
    {{entra-audience}}          expected "aud" claim on inbound Entra tokens
    {{gateway-sso-audience}}    "aud" for Claude Desktop interactive sign-in
    {{gateway-allowed-groups}}  group object IDs allowed to use the gateway
    {{foundry-token-resource}}  resource the gateway managed identity requests
    {{foundry-deployments-uri}} ARM deployments collection, read for discovery
    {{content-safety-endpoint}} Azure AI Content Safety base URL for guardrails

  __TOKENS_PER_MINUTE__, __BACKEND_ID__, __MODEL_DISCOVERY__,
  __DISCOVERY_CACHE_SECONDS__, __GUARDRAILS__ and
  __GUARDRAIL_SEVERITY_THRESHOLD__ are substituted at deploy time by
  infra/modules/apim-anthropic-api.bicep.

  Note: C# string literals inside XML attributes must be escaped as &quot;.
-->
<policies>
  <inbound>
    <base />

    <!--
      STEP 1 - Inbound identity.

      subscriptionKey : the gateway validated the API Management subscription
                        key before policy execution, so nothing is left to do.
      entra           : require and validate a Microsoft Entra ID token.
      either          : validate an Entra token when one is presented,
                        otherwise fall back to the subscription key.
    -->
    <choose>
      <when condition="@(&quot;{{client-auth-mode}}&quot; == &quot;subscriptionKey&quot;)">
        <!-- Subscription key already validated by the gateway. -->
      </when>
      <when condition="@(&quot;{{client-auth-mode}}&quot; == &quot;either&quot; &amp;&amp; !context.Request.Headers.ContainsKey(&quot;Authorization&quot;))">
        <!--
          No bearer token, so an API Management subscription key must be the
          credential. In 'either' mode the API is deployed with
          subscriptionRequired = false (otherwise the gateway would reject
          Entra-only callers before this policy ever runs), which means the
          built-in check is off and the key must be enforced here.
        -->
        <choose>
          <when condition="@(context.Subscription == null)">
            <return-response>
              <set-status code="401" reason="Unauthorized" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-header name="x-gateway-error" exists-action="override">
                <value>NoCredentialPresented</value>
              </set-header>
              <set-body>{ "type": "error", "error": { "type": "authentication_error", "message": "Unauthorized. Present either a Microsoft Entra ID bearer token in the Authorization header or a valid API Management subscription key." } }</set-body>
            </return-response>
          </when>
        </choose>
      </when>
      <otherwise>
        <validate-azure-ad-token tenant-id="{{entra-tenant-id}}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized. A valid Microsoft Entra ID token is required to call this gateway." output-token-variable-name="callerToken">
          <audiences>
            <audience>{{entra-audience}}</audience>
            <audience>{{entra-audience-alt}}</audience>
            <!--
              Audiences for the gateway interactive sign-in app. Claude Desktop's
              "Interactive sign-in" credential kind signs the user in against a
              customer-owned registration and sends that app's access token, so
              the gateway is the token's real audience. Both forms are listed
              because the shape depends on requestedAccessTokenVersion: v2 tokens
              carry the bare application ID GUID, v1 tokens carry api://{guid}.
            -->
            <audience>{{gateway-sso-audience}}</audience>
            <audience>{{gateway-sso-audience-alt}}</audience>
          </audiences>
        </validate-azure-ad-token>
      </otherwise>
    </choose>

    <!--
      STEP 1b - Group authorization for interactive sign-in.

      Authentication proves who the caller is; it does not decide whether they
      are allowed to use the gateway. That decision is made here, from the
      'groups' claim, because the alternative - switching the app registration to
      "Assignment required" - would force an administrator to consent to the app.
      Microsoft's guidance is explicit that assignment-required applications
      "must have their permissions consented by an administrator", which is
      precisely the constraint this scenario exists to avoid.

      The consequence is worth stating plainly: an unauthorized user still signs
      in successfully and is refused here with 403. Sign-in itself is only
      blocked by assignment-required or Conditional Access.

      The check is deliberately narrow. It runs only for tokens whose audience is
      the gateway sign-in app, so subscription-key callers and the existing
      Cognitive Services token flow are untouched - those tokens come from a
      different resource application and never carry a 'groups' claim.
    -->
    <set-variable name="groupAuthz" value="@{
        if (!context.Variables.ContainsKey(&quot;callerToken&quot;))
        {
            return &quot;skip&quot;;
        }

        var allowedRaw = &quot;{{gateway-allowed-groups}}&quot;;
        if (string.IsNullOrWhiteSpace(allowedRaw) || allowedRaw == &quot;disabled&quot;)
        {
            return &quot;skip&quot;;
        }

        var jwt = (Jwt)context.Variables[&quot;callerToken&quot;];
        var audience = jwt.Claims.ContainsKey(&quot;aud&quot;) ? jwt.Claims[&quot;aud&quot;].FirstOrDefault() : &quot;&quot;;
        var ssoAudience = &quot;{{gateway-sso-audience}}&quot;;
        if (audience != ssoAudience &amp;&amp; audience != &quot;{{gateway-sso-audience-alt}}&quot;)
        {
            return &quot;skip&quot;;
        }

        // Entra drops the 'groups' claim entirely and substitutes '_claim_names'
        // once a caller belongs to more than 200 groups. The app requests
        // ApplicationGroup precisely so only groups assigned to it are emitted
        // and the ceiling is never approached, but if it ever happens the claim
        // is unreadable here and the only safe answer is to refuse.
        if (jwt.Claims.ContainsKey(&quot;_claim_names&quot;))
        {
            return &quot;overage&quot;;
        }

        if (!jwt.Claims.ContainsKey(&quot;groups&quot;))
        {
            return &quot;no-groups&quot;;
        }

        var held = jwt.Claims[&quot;groups&quot;];
        var allowed = allowedRaw.Split(',').Select(g =&gt; g.Trim()).Where(g =&gt; g.Length &gt; 0);
        return allowed.Any(a =&gt; held.Contains(a)) ? &quot;allow&quot; : &quot;not-member&quot;;
    }" />

    <choose>
      <when condition="@(((string)context.Variables[&quot;groupAuthz&quot;]) == &quot;skip&quot; || ((string)context.Variables[&quot;groupAuthz&quot;]) == &quot;allow&quot;)">
        <!-- Authorized, or not subject to the group check. -->
      </when>
      <otherwise>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-gateway-error" exists-action="override">
            <value>GroupNotAuthorized</value>
          </set-header>
          <!-- Which of the three refusal reasons fired, for support triage. -->
          <set-header name="x-gateway-authz-reason" exists-action="override">
            <value>@((string)context.Variables["groupAuthz"])</value>
          </set-header>
          <set-body>{ "type": "error", "error": { "type": "permission_error", "message": "Forbidden. Your account is not a member of a group approved to use this AI gateway. Contact your administrator to request access." } }</set-body>
        </return-response>
      </otherwise>
    </choose>

    <!--
      Identify the caller for governance and telemetry. Prefers the Entra
      object ID, then the API Management subscription, then the client IP, so
      the expression never throws regardless of the authentication mode.
    -->
    <set-variable name="callerId" value="@{
        if (context.Variables.ContainsKey(&quot;callerToken&quot;))
        {
            var jwt = (Jwt)context.Variables[&quot;callerToken&quot;];
            if (jwt.Claims.ContainsKey(&quot;oid&quot;))
            {
                return jwt.Claims[&quot;oid&quot;].FirstOrDefault();
            }
            if (jwt.Claims.ContainsKey(&quot;appid&quot;))
            {
                return jwt.Claims[&quot;appid&quot;].FirstOrDefault();
            }
        }
        if (context.Subscription != null)
        {
            return context.Subscription.Id;
        }
        return context.Request.IpAddress;
    }" />

    <!--
      STEP 1b - Model discovery.

      Foundry's Anthropic surface does not implement GET /v1/models; it answers
      404 api_not_supported. Claude Desktop's "Model discovery" toggle calls
      exactly that path at launch, so without this block the toggle can only
      fail. The gateway therefore answers the call itself.

      Deliberately placed AFTER authentication (so the deployment inventory is
      not public) but BEFORE token governance (a metadata call consumes no model
      tokens, and llm-token-limit has no request body to inspect on a GET).

      The list is built from ARM rather than hard-coded, so adding a deployment
      in Foundry shows up in the client without touching this policy.
    -->
    <choose>
      <when condition="@(&quot;__MODEL_DISCOVERY__&quot; == &quot;enabled&quot; &amp;&amp; context.Operation.Id == &quot;models-list&quot;)">
        <cache-lookup-value key="@(&quot;anthropic-models-&quot; + context.Api.Revision)" variable-name="cachedModels" caching-type="internal" />
        <choose>
          <when condition="@(!context.Variables.ContainsKey(&quot;cachedModels&quot;))">
            <authentication-managed-identity resource="https://management.azure.com/" output-token-variable-name="armToken" ignore-error="false" />
            <send-request mode="new" response-variable-name="armResponse" timeout="20" ignore-error="true">
              <set-url>{{foundry-deployments-uri}}</set-url>
              <set-method>GET</set-method>
              <set-header name="Authorization" exists-action="override">
                <value>@("Bearer " + (string)context.Variables["armToken"])</value>
              </set-header>
            </send-request>
            <set-variable name="cachedModels" value="@{
                var models = new JArray();
                try
                {
                    var armResponse = (IResponse)context.Variables[&quot;armResponse&quot;];
                    if (armResponse != null &amp;&amp; armResponse.StatusCode == 200)
                    {
                        var deployments = armResponse.Body.As&lt;JObject&gt;()[&quot;value&quot;] as JArray;
                        if (deployments != null)
                        {
                            foreach (var deployment in deployments)
                            {
                                var props = deployment[&quot;properties&quot;];
                                if (props == null) { continue; }

                                // Only Anthropic-format deployments speak the
                                // Messages API this gateway exposes. A GPT or
                                // Llama deployment listed here would appear in
                                // the picker and then fail on every request.
                                var model = props[&quot;model&quot;];
                                if (model == null || (string)model[&quot;format&quot;] != &quot;Anthropic&quot;) { continue; }
                                if ((string)props[&quot;provisioningState&quot;] != &quot;Succeeded&quot;) { continue; }

                                var name = (string)deployment[&quot;name&quot;];
                                var created = props[&quot;createdAt&quot;] != null
                                    ? (string)props[&quot;createdAt&quot;]
                                    : DateTime.UtcNow.ToString(&quot;yyyy-MM-ddTHH:mm:ssZ&quot;);

                                var entry = new JObject();
                                entry[&quot;type&quot;] = &quot;model&quot;;
                                // The Messages API keys off the DEPLOYMENT
                                // name, not the underlying model id, so that
                                // is what the client must send back.
                                entry[&quot;id&quot;] = name;
                                entry[&quot;display_name&quot;] = name;
                                entry[&quot;created_at&quot;] = created;
                                models.Add(entry);
                            }
                        }
                    }
                }
                catch (Exception)
                {
                    // Fall through to an empty list; the client keeps whatever
                    // model list it was configured with.
                }

                var payload = new JObject();
                payload[&quot;data&quot;] = models;
                payload[&quot;has_more&quot;] = false;
                payload[&quot;first_id&quot;] = models.Count &gt; 0 ? models[0][&quot;id&quot;] : null;
                payload[&quot;last_id&quot;] = models.Count &gt; 0 ? models[models.Count - 1][&quot;id&quot;] : null;
                return payload.ToString(Newtonsoft.Json.Formatting.None);
            }" />
            <cache-store-value key="@(&quot;anthropic-models-&quot; + context.Api.Revision)" value="@((string)context.Variables[&quot;cachedModels&quot;])" duration="__DISCOVERY_CACHE_SECONDS__" caching-type="internal" />
          </when>
        </choose>
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="x-gateway-synthesised" exists-action="override">
            <value>models-list</value>
          </set-header>
          <set-body>@((string)context.Variables["cachedModels"])</set-body>
        </return-response>
      </when>
    </choose>

    <!--
      STEP 2 - Token governance.

      The llm-token-limit policy understands the Anthropic Messages API schema
      on API Management v2 tiers. It returns 429 once the per-caller budget is
      exhausted and reports consumption back on every response.
    -->
    <llm-token-limit counter-key="@((string)context.Variables[&quot;callerId&quot;])" tokens-per-minute="__TOKENS_PER_MINUTE__" estimate-prompt-tokens="false" remaining-tokens-header-name="x-gateway-tokens-remaining" tokens-consumed-header-name="x-gateway-tokens-consumed" retry-after-header-name="Retry-After" />

    <!-- Emit prompt, completion and total token counts to Application Insights. -->
    <llm-emit-token-metric namespace="foundry-ai-gateway">
      <dimension name="CallerId" value="@((string)context.Variables[&quot;callerId&quot;])" />
      <dimension name="ApiId" value="@(context.Api.Id)" />
      <dimension name="OperationId" value="@(context.Operation.Id)" />
    </llm-emit-token-metric>

    <!--
      STEP 2b - Prompt guardrails (native llm-content-safety).

      Microsoft's platform RAI content filter does NOT execute for
      Anthropic-format deployments: raiPolicyName is accepted on the ARM
      resource but the runtime filter pipeline only intercepts the Azure OpenAI
      inference surface, not /anthropic/v1/messages. A prompt that should trip a
      blocking filter reaches Claude and is answered with Claude's own refusal
      (HTTP 200, stop_reason "end_turn") rather than an Azure block. So the
      gateway enforces, using API Management's native llm-content-safety policy.

      The policy is preceded by a normalisation step, and that step is load
      bearing rather than cosmetic. Two measured behaviours make it necessary:

        1. FAIL-OPEN ON system-AS-ARRAY. The Anthropic Messages API accepts
           "system" as either a string or an array of content blocks, and the
           Claude apps send the array form. When "system" is an array the native
           policy does not merely mis-score the request - it skips inspection
           entirely and returns 200. Verified by setting every category to
           threshold 0, which blocks anything the policy actually looks at:
           a string "system" was blocked, the identical request with an array
           "system" was not.

        2. HARD 403 OVER 10,000 CHARACTERS. The prompt window is fixed at 10,000
           characters for requests - window-size is documented as configurable
           for responses only - and the policy returns 403 when the content
           exceeds the Content Safety character limit. Claude Code routinely
           sends far more than that in system prompts, tool definitions and
           pasted files, so an unbounded body would make every real request fail
           closed.

        3. SEVERITY DILUTION WHEN TEXT IS CONCATENATED. Content Safety scores a
           submission as a whole, so padding a harmful sentence with benign text
           lowers its severity. This is not theoretical: with the threshold at 4,
           a violence prompt sent alone was blocked, the same prompt prefixed
           with the single character "X" was blocked, and the same prompt
           prefixed with "You are helpful." was ALLOWED. Flattening the system
           prompt and the user turn into one probe therefore hands every caller a
           trivial bypass - a longer system prompt is a weaker guardrail.

      So the request body is replaced with a small canonical probe, and the system
      text and the user turn are probed SEPARATELY so neither can dilute the
      other. Each probe is bounded below the character limit. The original body is
      put back immediately afterwards, so the model still receives the caller's
      exact payload, including cache_control markers and tool definitions.

      Only the last user turn is inspected. Earlier turns were screened when they
      were sent, and re-scanning the whole history costs latency and hits the
      character limit fast.

      Placed after token governance so a caller cannot use blocked prompts to
      amplify Content Safety calls, and before set-backend-service so a blocked
      prompt costs no model tokens.
    -->
    <choose>
      <when condition="@(&quot;__GUARDRAILS__&quot; == &quot;enabled&quot; &amp;&amp; context.Request.Method == &quot;POST&quot;)">
        <!--
          preserveContent: true - the body must survive both this read and the
          substitution below, because the backend still needs the original.
        -->
        <set-variable name="originalBody" value="@(context.Request.Body.As&lt;string&gt;(true))" />

        <!--
          Flattened system text, or "" when the caller sent none. Kept in a
          variable so it can be probed on its own, away from the user turn.
        -->
        <set-variable name="csSystemText" value="@{ var sb = new System.Text.StringBuilder(); try { var body = JObject.Parse((string)context.Variables[&quot;originalBody&quot;]); var system = body[&quot;system&quot;]; if (system != null) { if (system.Type == JTokenType.String) { sb.AppendLine((string)system); } else if (system is JArray) { foreach (var block in (JArray)system) { if (block[&quot;text&quot;] != null) { sb.AppendLine((string)block[&quot;text&quot;]); } } } } } catch (Exception) { } return sb.ToString().Trim(); }" />

        <!--
          PROBE 1 - the system prompt, scored alone. Claude Desktop lets the user
          write this, so it is attacker-controlled and has to be screened; but it
          is usually long and benign, which is exactly what drags a concatenated
          score below the threshold. Skipped entirely when there is no system
          prompt, so the common case still costs one Content Safety call.
        -->
        <choose>
          <when condition="@(((string)context.Variables[&quot;csSystemText&quot;]).Length &gt; 0)">
            <set-body>@{
                var text = (string)context.Variables["csSystemText"];
                if (text.Length &gt; 9000)
                {
                    text = text.Substring(0, 4500) + "\n...\n" + text.Substring(text.Length - 4500);
                }
                var probe = new JObject();
                probe["model"] = "claude";
                probe["max_tokens"] = 1;
                var turn = new JObject();
                turn["role"] = "user";
                turn["content"] = text;
                probe["messages"] = new JArray(turn);
                return probe.ToString(Newtonsoft.Json.Formatting.None);
            }</set-body>
            <llm-content-safety backend-id="__CONTENT_SAFETY_BACKEND_ID__" shield-prompt="true">
              <categories output-type="EightSeverityLevels">
                <category name="Hate" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
                <category name="SelfHarm" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
                <category name="Sexual" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
                <category name="Violence" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
              </categories>
            </llm-content-safety>
          </when>
        </choose>

        <!--
          PROBE 2 - the last user turn, scored alone. "content" is a string in the
          SDKs and an array of content blocks in Claude Desktop and Claude Code;
          flattening both is what closes the fail-open. Only the last turn is
          inspected: earlier turns were screened when they were sent.
        -->
        <set-body>@{
            var sb = new System.Text.StringBuilder();
            var model = "claude";
            try
            {
                var body = JObject.Parse((string)context.Variables["originalBody"]);
                if (body["model"] != null) { model = (string)body["model"]; }

                var messages = body["messages"] as JArray;
                JToken last = null;
                if (messages != null)
                {
                    foreach (var message in messages)
                    {
                        if ((string)message["role"] == "user") { last = message; }
                    }
                }

                if (last != null)
                {
                    var content = last["content"];
                    if (content != null)
                    {
                        if (content.Type == JTokenType.String)
                        {
                            sb.AppendLine((string)content);
                        }
                        else if (content is JArray)
                        {
                            foreach (var block in (JArray)content)
                            {
                                if ((string)block["type"] == "text" &amp;&amp; block["text"] != null)
                                {
                                    sb.AppendLine((string)block["text"]);
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception)
            {
                // A body we cannot parse is still inspected, as itself, rather
                // than being waved through.
                sb.Append((string)context.Variables["originalBody"]);
            }

            var text = sb.ToString().Trim();
            if (text.Length == 0) { text = "(no inspectable text)"; }

            // Head and tail sampling. Anything over the limit would be rejected
            // outright by Content Safety, so a long legitimate paste has to be
            // reduced rather than refused. The trade-off is that content buried
            // in the middle of a very large turn is not seen - see
            // docs/08-guardrails.md.
            if (text.Length &gt; 9000)
            {
                text = text.Substring(0, 4500) + "\n...\n" + text.Substring(text.Length - 4500);
            }

            var probe = new JObject();
            probe["model"] = model;
            probe["max_tokens"] = 1;
            var turn = new JObject();
            turn["role"] = "user";
            turn["content"] = text;
            probe["messages"] = new JArray(turn);
            return probe.ToString(Newtonsoft.Json.Formatting.None);
        }</set-body>

        <!--
          shield-prompt covers jailbreak and prompt-injection detection; the
          categories cover harm severity. Both run against the probe body above.
        -->
        <llm-content-safety backend-id="__CONTENT_SAFETY_BACKEND_ID__" shield-prompt="true">
          <categories output-type="EightSeverityLevels">
            <category name="Hate" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
            <category name="SelfHarm" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
            <category name="Sexual" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
            <category name="Violence" threshold="__GUARDRAIL_SEVERITY_THRESHOLD__" />
          </categories>
        </llm-content-safety>

        <!-- Restore the caller's exact payload for the model. -->
        <set-body>@((string)context.Variables["originalBody"])</set-body>
        <set-variable name="guardrailVerdict" value="allow" />
      </when>
    </choose>

    <!--
      STEP 2c - Semantic cache lookup.

      Vectorises the prompt through the embeddings deployment and returns a
      stored completion when a previous prompt was close enough in meaning.
      Placed after the guardrail so a blocked prompt can never be answered from
      cache, and before backend routing so a hit costs no model tokens.

      score-threshold is a distance: lower is stricter. Commented out entirely
      when the cache is disabled, because these policies have no "off" switch
      and cannot be nested inside a choose.
    -->
    __CACHE_OPEN__<llm-semantic-cache-lookup score-threshold="__CACHE_SCORE_THRESHOLD__" embeddings-backend-id="__EMBEDDINGS_BACKEND_ID__" embeddings-backend-auth="system-assigned" ignore-system-messages="true" max-message-count="10">
      <vary-by>@((string)context.Variables["callerId"])</vary-by>
      <!--
        An optional second partition key. Callers that must not share cached
        answers across projects, sessions or tenants send their own scope in
        x-gateway-cache-scope; everyone else sends nothing and shares one
        partition per caller, which is the default behaviour.

        This is also the only reliable way to force a cold cache. A random
        nonce inside the prompt does not work: the lookup is semantic, so an
        embedding ignores a GUID and the request is still a hit.
      -->
      <vary-by>@(context.Request.Headers.GetValueOrDefault("x-gateway-cache-scope",""))</vary-by>
    </llm-semantic-cache-lookup>__CACHE_CLOSE__

    <!-- STEP 3 - Backend routing and backend identity. -->
    <set-backend-service backend-id="__BACKEND_ID__" />

    <choose>
      <when condition="@(&quot;{{backend-auth-mode}}&quot; == &quot;passthrough&quot;)">
        <!--
          The caller's own Entra token is forwarded unchanged. Foundry
          evaluates Azure RBAC against the end user, so per-user access control
          and audit trails are preserved end to end.
        -->
        <set-header name="api-key" exists-action="delete" />
        <set-header name="x-api-key" exists-action="delete" />
      </when>
      <otherwise>
        <!--
          The gateway swaps the client credential for its own managed identity
          token. Clients never hold a Foundry credential, so the Foundry
          account can have local (key) authentication disabled entirely.
        -->
        <authentication-managed-identity resource="{{foundry-token-resource}}" output-token-variable-name="foundryToken" ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
          <value>@("Bearer " + (string)context.Variables["foundryToken"])</value>
        </set-header>
        <set-header name="api-key" exists-action="delete" />
        <set-header name="x-api-key" exists-action="delete" />
      </otherwise>
    </choose>

    <!-- Never leak the gateway credential to the model backend. -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />

    <!--
      The Messages API requires a version header. Supplying a default keeps
      minimal clients and the portal test console working unchanged.
    -->
    <set-header name="anthropic-version" exists-action="skip">
      <value>2023-06-01</value>
    </set-header>
  </inbound>

  <backend>
    <!--
      buffer-response="false" is required for Claude's server-sent event
      streaming, which Claude Code uses for every request.
    -->
    <forward-request buffer-response="false" timeout="240" />
  </backend>

  <outbound>
    <!--
      Store before <base /> so the completion is captured as the policy document
      specifies. Only 200 responses are cached by default, so an error is never
      served back to a later caller.
    -->
    __CACHE_OPEN__<llm-semantic-cache-store duration="__CACHE_DURATION_SECONDS__" />__CACHE_CLOSE__
    <base />
    <!-- Makes the gateway hop visible during the demo without altering the payload. -->
    <set-header name="x-gateway" exists-action="override">
      <value>azure-api-management</value>
    </set-header>
    <!--
      Prove the guardrail ran even when it allowed the request through, so a
      demo can distinguish "checked and allowed" from "never inspected". A
      blocked request never reaches outbound - llm-content-safety returns its
      own 403 - so this header only ever reports the allow case.
    -->
    <set-header name="x-guardrail" exists-action="override">
      <value>@(context.Variables.ContainsKey("guardrailVerdict") ? "checked:" + (string)context.Variables["guardrailVerdict"] : "not-inspected")</value>
    </set-header>
    <set-header name="x-guardrail-enforced-by" exists-action="override">
      <value>@(context.Variables.ContainsKey("guardrailVerdict") ? "apim-llm-content-safety" : "none")</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <set-header name="x-gateway-error" exists-action="override">
      <value>@(context.LastError != null ? context.LastError.Reason : "unknown")</value>
    </set-header>

    <!--
      Re-shape the guardrail block into an Anthropic-style error.

      llm-content-safety returns its own generic body,
      {"statusCode":403,"message":"Request failed content safety check."}.
      Claude Desktop and Claude Code map any 403 onto their auth path and render
      it as "Failed to authenticate", which sends people looking at tokens and
      keys instead of at the prompt they just typed. Detection stays entirely
      native - this only rewrites the reply so the client can describe it
      accurately - and it restores the x-guardrail-blocked header that the
      hand-written policy used to emit.
    -->
    <choose>
      <when condition="@(context.LastError != null &amp;&amp; context.LastError.Reason != null &amp;&amp; context.LastError.Reason.Contains(&quot;ContentSafety&quot;))">
        <set-status code="403" reason="Blocked by content safety" />
        <set-header name="Content-Type" exists-action="override">
          <value>application/json</value>
        </set-header>
        <set-header name="x-guardrail-blocked" exists-action="override">
          <value>content-safety</value>
        </set-header>
        <set-header name="x-guardrail-enforced-by" exists-action="override">
          <value>apim-llm-content-safety</value>
        </set-header>
        <set-body>@{
            var error = new JObject();
            error["type"] = "invalid_request_error";
            error["message"] = "Blocked by Azure AI Content Safety at the API Management gateway before the model was called. This is a content policy decision, not an authentication failure. Rephrase the request, or check the API Management diagnostic logs for the category that fired.";
            var envelope = new JObject();
            envelope["type"] = "error";
            envelope["error"] = error;
            return envelope.ToString(Newtonsoft.Json.Formatting.None);
        }</set-body>
      </when>
    </choose>
  </on-error>
</policies>
