# Claude on Microsoft Foundry - example configuration
#
# Do not edit this file for your own use. Generate a real .env instead:
#
#   ./scripts/New-ClaudeConfig.ps1 -Mode Direct  -Apply
#   ./scripts/New-ClaudeConfig.ps1 -Mode Gateway -EnvFile .env.gateway
#
# The generator reads .deployment-outputs.json, so every value below is
# filled in from the deployment rather than typed by hand. Real .env files
# are gitignored; only this example is committed.
#
# Both scenarios share one file format. inferenceProvider selects which
# block Claude Desktop reads - the other block is ignored.

# ---------------------------------------------------------------------
# Azure context - informational, not read by either client
# ---------------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-claudedemo-demo
FOUNDRY_ACCOUNT_NAME=claudedemo-demo-abc123
FOUNDRY_ANTHROPIC_BASE_URL=https://claudedemo-demo-abc123.services.ai.azure.com/anthropic
GATEWAY_ANTHROPIC_BASE_URL=https://apim-claudedemo-demo-abc123.azure-api.net/anthropic

# Application (client) ID of the Entra app registration created by
# scripts/New-FoundryAppRegistration.ps1. This is NOT the tenant ID.
ENTRA_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------
# Claude Desktop - shared keys
# https://claude.com/docs/third-party/claude-desktop/configuration
# ---------------------------------------------------------------------

# foundry = scenario 1 (direct), gateway = scenario 2 (via APIM).
# Setting this activates third-party mode.
inferenceProvider=foundry

# interactive = Entra sign-in, static = API key. When set, only that
# source is used - there is no fallback.
inferenceCredentialKind=interactive

# How long a sign-in stays valid under your IdP session policy.
inferenceSessionLifetimeSec=86400

# Model picker contents. "name" is the Foundry deployment name and the
# first entry is the default. anthropicFamilyTier drives Claude's own
# sonnet/haiku routing.
inferenceModels="[{\"name\":\"claude-sonnet-4-6\",\"labelOverride\":\"claude-sonnet-4-6\",\"anthropicFamilyTier\":\"sonnet\"},{\"name\":\"claude-haiku-4-5\",\"labelOverride\":\"claude-haiku-4-5\",\"anthropicFamilyTier\":\"haiku\"}]"

# Foundry exposes no Anthropic model-listing endpoint, so discovery
# stays off and the list above is authoritative.
modelDiscoveryEnabled=false

# HTTPS origin for artifact previews. Empty uses the commercial host.
userContentRendererUrl=""

# ---------------------------------------------------------------------
# Scenario 1 - Foundry provider (inferenceProvider=foundry)
# ---------------------------------------------------------------------

# Resource name only; Claude constructs the endpoint URL from it.
inferenceFoundryResource=claudedemo-demo-abc123

# Directory (tenant) ID of the app registration.
inferenceFoundryTenantId=00000000-0000-0000-0000-000000000000

# Application (client) ID of that registration. NOT the tenant ID -
# Claude's own settings screenshot shows this box filled with a tenant
# ID, which fails with AADSTS700016.
inferenceFoundryClientId=00000000-0000-0000-0000-000000000000

# device-code | browser | broker
#   device-code needs public client flows enabled
#   browser     needs redirect URI http://127.0.0.1/callback
#   broker      needs ms-appx-web://Microsoft.AAD.BrokerPlugin/{clientId}
inferenceFoundryAuthFlow=browser

# Empty under interactive sign-in. Tenant policy on this deployment
# forces disableLocalAuth=true, so keys are unavailable anyway.
inferenceFoundryApiKey=""

# ---------------------------------------------------------------------
# Scenario 2 - Gateway provider (inferenceProvider=gateway)
# ---------------------------------------------------------------------

# Full gateway URL, including the /anthropic suffix.
inferenceGatewayBaseUrl=https://apim-claudedemo-demo-abc123.azure-api.net/anthropic

# Entra sign-in against the gateway. Claude mints an access token for
# the audience in "scopes" and sends it as Authorization: Bearer.
# The APIM policy validates issuer AND audience - a signature check
# alone would accept any token minted by the tenant.
#
# scopes must be https://cognitiveservices.azure.com/.default.
# https://ai.azure.com has no enumerable service principal, so a custom
# app registration can never request it; the gateway accepts both
# audiences precisely so that this path works.
inferenceGatewayOidc="{\"issuer\":\"https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0\",\"clientId\":\"00000000-0000-0000-0000-000000000000\",\"tokenType\":\"access_token\",\"scopes\":[\"https://cognitiveservices.azure.com/.default\"]}"

# browser | broker. device-code is not supported on this provider.
inferenceGatewayOidcAuthFlow=browser

# Static-key alternative to OIDC. Only used when
# inferenceCredentialKind=static; the header name must match the
# gateway's gatewaySubscriptionKeyHeader.
inferenceGatewayApiKey=""
inferenceGatewayAuthScheme=x-api-key

# ---------------------------------------------------------------------
# Claude Code (CLI)
# ---------------------------------------------------------------------
CLAUDE_CODE_USE_FOUNDRY=1

# Direct path: resource name only, Claude Code appends /anthropic.
ANTHROPIC_FOUNDRY_RESOURCE=claudedemo-demo-abc123

# Gateway path: full base URL, already including /anthropic. Set this
# instead of ANTHROPIC_FOUNDRY_RESOURCE, not alongside it.
# ANTHROPIC_FOUNDRY_BASE_URL=https://apim-claudedemo-demo-abc123.azure-api.net/anthropic

# Pin every model. Foundry performs no startup model check, so an
# unpinned alias fails at the first request rather than at launch.
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
