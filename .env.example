# Claude on Microsoft Foundry - example configuration
#
# Do not edit this file for your own use. Generate a real .env instead:
#
#   # Entra (needs the app registration, and user consent or an admin grant)
#   ./scripts/New-ClaudeConfig.ps1 -Mode Direct  -Apply
#   ./scripts/New-ClaudeConfig.ps1 -Mode Gateway -EnvFile .env.gateway
#
#   # API key (no Entra app, no consent, no directory admin)
#   ./scripts/New-ClaudeConfig.ps1 -Mode Direct  -CredentialKind static -Apply
#   ./scripts/New-ClaudeConfig.ps1 -Mode Gateway -CredentialKind static -EnvFile .env.gateway
#
# The generator reads .deployment-outputs.json and, for the key scenarios,
# reads BOTH live keys out of Azure - the Foundry account key and the API
# Management subscription key - so either provider can be selected afterwards
# without regenerating. Every value below is filled in from the deployment
# rather than typed by hand.
#
# Real .env files contain live secrets and are gitignored. Only this example
# is committed. Never paste a real key into it.
#
# There are two independent axes, giving four demonstrable scenarios:
#
#                    | inferenceProvider=foundry | inferenceProvider=gateway
#   -----------------+---------------------------+--------------------------
#   Kind=interactive | 1. direct + Entra         | 3. gateway + Entra
#   Kind=static      | 2. direct + API key       | 4. gateway + APIM key
#
# inferenceProvider selects the endpoint block; inferenceCredentialKind
# selects the credential. Keys belonging to the unselected combination are
# ignored, so one file can carry them all - and the generator writes them all.
# A generated .env describes both providers, so switching scenario afterwards
# is an edit to those two lines rather than a regeneration.
#
# The one exception is the Claude Code block at the end: those are process
# environment variables and there is only one ANTHROPIC_FOUNDRY_API_KEY, so
# the generator leaves the unselected pair commented out.

# ---------------------------------------------------------------------
# Azure context - informational, not read by either client
# ---------------------------------------------------------------------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-claudedemo-demo
FOUNDRY_ACCOUNT_NAME=claudedemo-demo-abc123
FOUNDRY_ANTHROPIC_BASE_URL=https://claudedemo-demo-abc123.services.ai.azure.com/anthropic
GATEWAY_ANTHROPIC_BASE_URL=https://apim-claudedemo-demo-abc123.azure-api.net/anthropic

# Application (client) ID of the Entra app registration created by
# scripts/New-FoundryAppRegistration.ps1. Only needed for the Entra
# scenarios; leave empty when using a key.
ENTRA_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------
# Claude Desktop - shared keys
# https://claude.com/docs/third-party/claude-desktop/configuration
# ---------------------------------------------------------------------

# foundry = direct to Foundry, gateway = via APIM.
# Setting this activates third-party mode.
inferenceProvider=foundry

# interactive = Entra sign-in, static = API key. When set, only that
# source is used - there is no fallback to the other.
#
# Use static when your tenant blocks user consent: the Entra path needs
# either self-service consent or a directory admin to grant the app's
# Cognitive Services permission, and "Need admin approval" means neither
# is available to you.
inferenceCredentialKind=interactive

# How long a sign-in stays valid under your IdP session policy.
# Irrelevant under static credentials.
inferenceSessionLifetimeSec=86400

# Model picker contents. "name" is the Foundry deployment name and the
# first entry is the default. anthropicFamilyTier drives Claude's own
# sonnet/haiku routing.
inferenceModels="[{\"name\":\"claude-sonnet-4-6\",\"labelOverride\":\"claude-sonnet-4-6\",\"anthropicFamilyTier\":\"sonnet\"},{\"name\":\"claude-haiku-4-5\",\"labelOverride\":\"claude-haiku-4-5\",\"anthropicFamilyTier\":\"haiku\"}]"

# Foundry answers GET /v1/models with 404 api_not_supported, so discovery
# must stay off when inferenceProvider=foundry and the list above is
# authoritative. With inferenceProvider=gateway set this to true: the gateway
# synthesises the model list from the account's deployments.
# See docs/04-claude-code-gateway.md#model-discovery.
modelDiscoveryEnabled=false

# HTTPS origin for artifact previews. Empty uses the commercial host.
userContentRendererUrl=""

# ---------------------------------------------------------------------
# Scenarios 1 and 2 - Foundry provider (inferenceProvider=foundry)
# ---------------------------------------------------------------------

# Resource name only; Claude constructs the endpoint URL from it.
inferenceFoundryResource=claudedemo-demo-abc123

# Directory (tenant) ID of the app registration.
inferenceFoundryTenantId=00000000-0000-0000-0000-000000000000

# --- Scenario 1: Entra (inferenceCredentialKind=interactive) ---

# Application (client) ID of that registration. NOT the tenant ID -
# Claude's own settings screenshot shows this box filled with a tenant
# ID, which fails with AADSTS700016.
inferenceFoundryClientId=00000000-0000-0000-0000-000000000000

# device-code | browser | broker
#   device-code needs public client flows enabled
#   browser     needs redirect URI http://127.0.0.1/callback
#   broker      needs ms-appx-web://Microsoft.AAD.BrokerPlugin/{clientId}
inferenceFoundryAuthFlow=browser

# --- Scenario 2: API key (inferenceCredentialKind=static) ---

# Foundry account key. Requires disableLocalAuth=false, which tenant
# policy permits only when the account is tagged SecurityControl=Ignore
# AT CREATE TIME (allowLocalAuthExemption in main.bicepparam).
#
#   az cognitiveservices account keys list -g <rg> -n <account> --query key1 -o tsv
#
# The Anthropic surface expects this on the x-api-key header, not
# api-key. Claude Desktop and Claude Code set the header for you.
inferenceFoundryApiKey=""

# ---------------------------------------------------------------------
# Scenarios 3 and 4 - Gateway provider (inferenceProvider=gateway)
# ---------------------------------------------------------------------

# Full gateway URL, including the /anthropic suffix.
inferenceGatewayBaseUrl=https://apim-claudedemo-demo-abc123.azure-api.net/anthropic

# --- Scenario 3: Entra (inferenceCredentialKind=interactive) ---

# Claude mints an access token for the audience in "scopes" and sends it
# as Authorization: Bearer. The APIM policy validates issuer AND
# audience - a signature check alone would accept any token minted by
# the tenant.
#
# scopes must be https://cognitiveservices.azure.com/.default.
# https://ai.azure.com has no enumerable service principal, so a custom
# app registration can never request it; the gateway accepts both
# audiences precisely so that this path works.
inferenceGatewayOidc="{\"issuer\":\"https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0\",\"clientId\":\"00000000-0000-0000-0000-000000000000\",\"tokenType\":\"access_token\",\"scopes\":[\"https://cognitiveservices.azure.com/.default\"]}"

# browser | broker. device-code is not supported on this provider.
inferenceGatewayOidcAuthFlow=browser

# --- Scenario 4: APIM subscription key (inferenceCredentialKind=static) ---

# API Management subscription key. Not the Foundry key - the gateway
# holds its own credential to Foundry via managed identity.
inferenceGatewayApiKey=""

# bearer | x-api-key - the only two schemes Claude Desktop can send.
# This must match the deployment's gatewaySubscriptionKeyHeader, which
# defaults to x-api-key for exactly that reason.
inferenceGatewayAuthScheme=x-api-key

# ---------------------------------------------------------------------
# Claude Code (CLI)
# ---------------------------------------------------------------------
CLAUDE_CODE_USE_FOUNDRY=1

# Direct path: resource name only, Claude Code appends /anthropic.
ANTHROPIC_FOUNDRY_RESOURCE=claudedemo-demo-abc123

# Gateway path: full base URL, already including /anthropic. Set this
# instead of ANTHROPIC_FOUNDRY_RESOURCE, not alongside it.
# ANTHROPIC_FOUNDRY_BASE_URL=https://apim-claudedemo-demo-abc123.azure-api.net/anthropic

# Key credential for either path. Leave unset to use the Entra
# credential chain from az login.
ANTHROPIC_FOUNDRY_API_KEY=""

# Pin every model. Foundry performs no startup model check, so an
# unpinned alias fails at the first request rather than at launch.
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
