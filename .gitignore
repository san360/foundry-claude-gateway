# Deployment outputs contain resource names and endpoints for the environment.
.deployment-outputs.json

# Generated client configuration (registry/plist/JSON payloads)
out/

# Compiled Bicep artifacts
*.bicep.json
infra/**/*.json
!infra/**/*.bicepparam

# Never commit credentials
*.key
.env
.env.*
!.env.example

# Guardrail evidence bundles. These contain full model responses to deliberately
# harmful probe prompts - on the direct path the model sometimes complies - so
# they stay local. Share a redacted extract, not the raw bundle.
results/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Claude Code state
.claude/settings.local.json
