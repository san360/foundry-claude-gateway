        <mxCell id="f3" value="gateway URL (path B)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;strokeColor=#82b366;fontSize=10;" edge="1" parent="1" source="dpath" target="gauth">
          <mxGeometry relative="1" as="geometry" />
