          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="PATH A - direct: no gateway, no guardrail, no rate limit" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;dashed=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontSize=10;fontColor=#b85450;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="clients" target="api">
