  <diagram id="userflow" name="Guardrail user flow">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t2" value="What happens to a single prompt" style="text;html=1;fontSize=17;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1020" height="30" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Client sends POST /v1/messages" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="300" height="45" as="geometry" />
        </mxCell>

        <mxCell id="dpath" value="Which base URL&#10;is configured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="465" y="145" width="170" height="90" as="geometry" />
        </mxCell>

        <mxCell id="dmodel" value="Straight to Claude in Foundry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="drai" value="Azure RAI filter?&#10;Never runs on the Anthropic surface,&#10;even with a strict policy attached" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="345" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dout" value="HTTP 200&#10;Either an answer or Claude's own refusal.&#10;Both look identical to your logs, metrics&#10;and policy - you control neither." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="gauth" value="Gateway: authenticate caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="270" width="300" height="42" as="geometry" />
        </mxCell>
        <mxCell id="gextract" value="Extract the most recent user turn&#10;(text blocks only, truncated to 9,000 chars)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="335" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gshield" value="text:shieldPrompt&#10;attackDetected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="410" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ganalyze" value="text:analyze&#10;any category severity 4 or above?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="470" y="530" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="gblock" value="HTTP 403 - blocked at the gateway&#10;x-guardrail-blocked: prompt_shield&#10;or hate:7 / violence:5 / sexual:6 / selfharm:5&#10;&#10;The model was never called.&#10;No tokens spent. The verdict is logged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="830" y="450" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="gforward" value="Swap credential for the gateway&#10;managed identity and forward to Claude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="670" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="gok" value="HTTP 200 with x-guardrail: checked:allow&#10;plus x-gateway-tokens-remaining&#10;&#10;Proof the check ran, not just that nothing broke." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="760" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;" edge="1" parent="1" source="start" target="dpath">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="Foundry URL (path A)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;strokeColor=#b85450;fontSize=10;dashed=1;" edge="1" parent="1" source="dpath" target="dmodel">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="190" y="190" /></Array>
